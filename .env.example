# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cafeqr:cafeqr@localhost:5434/cafeqr?schema=public

# ── Redis / queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PIN_MAX_ATTEMPTS=5

# ── Print agent ─────────────────────────────────────────────────────────────
PRINT_AGENT_TOKEN=
PRINT_AGENT_POLL_INTERVAL_MS=3000

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
