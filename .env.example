# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202,http://localhost:4203,http://localhost:4204
MENU_BASE_URL=http://localhost:4203

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cafeqr:cafeqr@localhost:5434/cafeqr?schema=public

# ── Redis / queues ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=./.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./.secrets/jwt-public.pem
JWT_ISSUER=cafeqr
JWT_AUDIENCE=cafeqr-api
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PIN_MAX_ATTEMPTS=5

# ── Print agent ─────────────────────────────────────────────────────────────
PRINT_AGENT_TOKEN=change-me
PRINT_AGENT_PORT=9100
PRINT_AGENT_NEGOCIO_ID=
PRINT_AGENT_SUCURSAL_ID=
CLOUD_API_URL=http://localhost:3000/api/v1
PRINT_AGENT_POLL_INTERVAL_MS=5000
PRINTER_MODE=dry-run
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_WIDTH=80
PRINT_AGENT_DB=./print-agent.sqlite

# ── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
SENTRY_DSN=
